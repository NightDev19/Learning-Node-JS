{
  "name": "Express",
  "description": "Minimal Node.js sample demonstrating package.json structure",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && babel src --out-dir dist --extensions \".js,.mjs,.jsx\" --verbose",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext js,json --inspect=9229 server.js",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js",
    "prepare": "echo \"prepare script ran (example)\"",
    "seed": "node src/seeds/seed.js"
  },
  "keywords": [
    "node",
    "package.json",
    "example"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.0",
    "rimraf": "^6.1.0",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2"
  }
}
